# =============================================================================
# AWS AI DevOps Agent — Environment Configuration Template
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your real values in .env
# 3. NEVER commit .env — it is listed in .gitignore
# =============================================================================


# =============================================================================
# MODEL PROVIDER
# =============================================================================

# Which backend to use for LLM inference.
# Options:
#   nvidia  — NVIDIA NIM / Nemotron (requires NVIDIA_API_KEY below)
#   sample  — Offline/stub mode, no external calls (safe default for local dev)
MODEL_PROVIDER=sample

# Model identifier sent to the provider API.
# Default matches NVIDIA Nemotron; change if you use a different NIM endpoint.
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b

# ------ NVIDIA NIM (required when MODEL_PROVIDER=nvidia) --------------------

# Get your key at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# NIM inference endpoint (leave as-is unless you have a self-hosted NIM)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ------ Tuning ---------------------------------------------------------------

# Seconds to wait for a model API response before timing out
MODEL_TIMEOUT=60.0

# How many times to retry a failed model API call before giving up
MODEL_MAX_RETRIES=3


# =============================================================================
# AWS
# =============================================================================

# AWS region used for all boto3 calls
AWS_REGION=us-east-1

# Optional: named AWS CLI profile (leave commented to use default credentials /
# IAM role / environment variables AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY)
# AWS_PROFILE=my-profile

# If you are NOT using a named profile, supply credentials directly:
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# AWS_SESSION_TOKEN=


# =============================================================================
# API SERVER
# =============================================================================

# Host to bind the FastAPI / Uvicorn server to
# Use 0.0.0.0 to accept connections from all interfaces
API_HOST=0.0.0.0

# Port the API server listens on
API_PORT=8000

# Number of Uvicorn worker processes (keep at 1 during local dev)
API_WORKERS=1

# Optional bearer token that clients must send in the Authorization header.
# Leave commented out to disable auth (dev only — always set in production!).
# API_KEY=change-me-to-a-long-random-secret

# Comma-separated list of origins allowed by CORS
# Add your frontend URL here (Vite default: 5173, CRA default: 3000)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173


# =============================================================================
# LOGGING
# =============================================================================

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Output format: json (structured, for log aggregators) | text (human-readable)
LOG_FORMAT=text


# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Automatically fall back to sample/stub mode when the primary provider fails.
# Recommended: true during development, false in production for hard failures.
ENABLE_SAMPLE_MODE=true

# Expose a /metrics endpoint in Prometheus format.
# Set to true only if you have a Prometheus scraper configured.
ENABLE_METRICS=false